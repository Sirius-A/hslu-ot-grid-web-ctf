# Optional. The compose already defaults to the published images, so you only
# need this file to override the namespace, the tag, or the host ports.
#
# Copy to `.env` (same folder as docker-compose.yml) if you want to change any.

# GHCR namespace to pull from (default shown):
# REGISTRY=ghcr.io/sirius-a/hslu-ot-grid-web-ctf

# Image tag to pull (default 1.0):
# VERSION=1.0

# Host ports (change only if something already uses these):
# WEB_PORT=8100
# COLLECTOR_PORT=8200
# SCADA_PORT=8300
