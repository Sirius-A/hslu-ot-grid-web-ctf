# Copy to .env and adjust per student / per instance.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# For several instances on one host, give each its own project name and ports:
#   ./ctf.sh up 07      ->  portal on :8107, collector on :8207

WEB_PORT=8100
COLLECTOR_PORT=8200

# Stage 1 flag (stolen supervisor session -> /admin).
FLAG=HSLU{s1_m4p_t00lt1p_1nn3rHTML_1s_n0t_4_t3xt_n0d3}

# Supervisor account used by the review bot. Students must not need this.
ADMIN_USER=ot.supervisor
# ADMIN_PASSWORD=   # blank -> portal randomises it per deployment; uncomment to pin for manual login

# Shared secret between portal and bot.
BOT_TOKEN=4f1c0a9d2b8e47d6

# Difficulty knobs.
#   MAX_LABEL_LENGTH=-1  full-length payloads allowed (default)
#   MAX_LABEL_LENGTH=50  library default: payload must fit in 50 characters
MAX_LABEL_LENGTH=-1
REVIEW_COOLDOWN_SECONDS=15
SESSION_TTL_MINUTES=30
PAGE_DWELL_MS=6000

# Stage 2 -- regional load dispatch centre (FUXA 1.3.0, CVE-2026-43947).
STAGE2_ENABLED=true
SCADA_PORT=8300
FLAG2=HSLU{s2_fux4_run5cr1pt_t35t_m0d3_1s_n0t_4n_4uth_ch3ck}
# FUXA's stock default credentials. The stage-2 RCE is unauthenticated, so these
# are only for viewing the HMI.
FUXA_ADMIN_USER=admin
FUXA_ADMIN_PASSWORD=123456
